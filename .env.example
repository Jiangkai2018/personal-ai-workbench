# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# AI 初评（可选）：Anthropic 兼容接口，如智谱 BigModel https://open.bigmodel.cn/api/anthropic
# 配置后：想法一键转机会时自动 AI 初评；机会页可用「AI 预评 / AI 初评」
WORKBENCH_AI_API_KEY=
WORKBENCH_AI_BASE_URL=https://open.bigmodel.cn/api/anthropic
WORKBENCH_AI_MODEL=glm-5.3

# 会话密钥（对外部署必改）
WORKBENCH_JWT_SECRET=

# 后端端口（默认 3000）
# PORT=3000

# 随手记账本特定配置（财务模块：成员归属/挂账账户，个人值放 .env）
WORKBENCH_SSJ_TOKEN=
WORKBENCH_SSJ_CLIENT_KEY=
WORKBENCH_SSJ_TRADING_ENTITY=
WORKBENCH_SSJ_ACCOUNT_ID=
WORKBENCH_SSJ_MEMBER_ME=
WORKBENCH_SSJ_MEMBER_FAMILY=
WORKBENCH_SSJ_BILL_OWNER_ME=
